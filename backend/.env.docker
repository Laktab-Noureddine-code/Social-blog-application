# =============================================================================
# DOCKER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env when running with Docker
# cp .env.docker .env
# =============================================================================

APP_NAME="Social Blog"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# =============================================================================
# DATABASE - MySQL Container
# =============================================================================
# IMPORTANT: DB_HOST must match the service name in docker-compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# =============================================================================
# CACHE & SESSION - Redis Container
# =============================================================================
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# IMPORTANT: REDIS_HOST must match the service name in docker-compose
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# =============================================================================
# BROADCASTING - Laravel Reverb
# =============================================================================
BROADCAST_CONNECTION=reverb

# Reverb Server Configuration
# IMPORTANT: Use 0.0.0.0 for the server to bind to all interfaces inside container
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# Server-side settings (where Reverb listens)
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# Client-side settings (how frontend connects)
# For local Docker: use localhost since that's how browser accesses it
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# =============================================================================
# MAIL CONFIGURATION
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# FILESYSTEM
# =============================================================================
FILESYSTEM_DISK=local

# =============================================================================
# SANCTUM (API Authentication)
# =============================================================================
# Add your frontend URL for CORS
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost
